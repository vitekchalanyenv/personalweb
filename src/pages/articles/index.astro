---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { SERIES } from '../../content.config';

const posts = (
  await getCollection(
    'articles',
    ({ data }) => data.lang === 'en' && (!data.draft || import.meta.env.DEV)
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const seriesEntries = Object.entries(SERIES) as [
  keyof typeof SERIES,
  (typeof SERIES)[keyof typeof SERIES],
][];

const grouped = seriesEntries.map(([key, meta]) => ({
  key,
  meta,
  posts: posts
    .filter((p) => p.data.series === key)
    .sort((a, b) => a.data.episode - b.data.episode),
}));
---

<Base
  title="Articles"
  description="Three running series on environment art for real production: how commercial kits get made, vegetation that survives a frame budget, and killing visible texture repetition."
>
  <div class="wrap top">
    <h1>Articles</h1>
    <p class="lede">
      Three series, each numbered and open-ended. Everything here is written
      against a specific engine version, includes the profiler numbers, and says
      what did not work — which is the part almost nobody writes down.
    </p>
  </div>

  <div class="wrap">
    {
      grouped.map(({ key, meta, posts }) => (
        <section class="series" id={key}>
          <header class="sh">
            <span class="pill" data-accent={meta.accent}>{meta.title}</span>
            <h2>{meta.tagline}</h2>
            <p class="blurb">{meta.blurb}</p>
            <p class="count">
              {posts.length === 0
                ? 'First part in progress.'
                : `${posts.length} part${posts.length === 1 ? '' : 's'} so far.`}
            </p>
          </header>

          {posts.length > 0 && (
            <div class="grid g3">
              {posts.map((p) => (
                <ArticleCard
                  slug={p.id}
                  title={p.data.shortTitle ?? p.data.title}
                  description={p.data.description}
                  series={p.data.series}
                  episode={p.data.episode}
                  date={p.data.date}
                  cover={p.data.cover}
                  coverAlt={p.data.coverAlt}
                />
              ))}
            </div>
          )}
        </section>
      ))
    }
  </div>
</Base>

<style>
  .top { padding-block: 44px 8px; }
  h1 { margin: 0 0 12px; }
  .lede { max-width: 64ch; color: var(--tx-2); font-size: 18px; margin: 0 0 20px; }
  .series {
    padding-block: 34px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 80px;
  }
  .sh { margin-bottom: 20px; max-width: 64ch; }
  .sh h2 { margin: 12px 0 8px; font-size: 24px; }
  .blurb { margin: 0 0 8px; color: var(--tx-2); font-size: 15.5px; }
  .count {
    margin: 0;
    font: 600 10.5px/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--tx-3);
  }
</style>
