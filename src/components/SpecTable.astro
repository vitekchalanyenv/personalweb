---
/**
 * SpecTable — the "here is exactly what this thing is" block.
 *
 * Put it near the top of any article about a kit, a material or a scene.
 * Technical readers scan for this before deciding to read, and stating engine
 * versions is the cheapest credibility signal available — content farms never
 * do it because they never opened the engine.
 */
interface Props {
  title?: string;
  rows: [string, string][];
}
const { title = 'Specs', rows } = Astro.props;
---

<div class="spec">
  <h4 class="spec-h">{title}</h4>
  <dl>
    {rows.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
  </dl>
</div>

<style>
  .spec {
    margin: 2em 0;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 16px 20px;
  }
  .spec-h {
    margin: 0 0 10px;
    font: 600 10.5px/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ac);
  }
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(120px, auto) 1fr;
    gap: 6px 18px;
    font-size: 15px;
  }
  dt { color: var(--tx-3); }
  dd { margin: 0; color: var(--tx-2); }
  dd :global(code) { font-size: 13.5px; }
  @media (max-width: 520px) {
    dl { grid-template-columns: 1fr; gap: 2px; }
    dt { margin-top: 8px; font-size: 13px; }
  }
</style>
