---
/**
 * Callout — for the two things that matter most in a technical article:
 * "this will bite you" (warn) and "this is the bit to remember" (key).
 *
 * `kind="wrong"` is deliberately included because the section nobody writes
 * is "what I tried that didn't work", and it deserves visual weight.
 */
interface Props {
  kind?: 'key' | 'warn' | 'wrong' | 'note';
  title?: string;
}
const { kind = 'note', title } = Astro.props;
const defaults: Record<string, string> = {
  key: 'The point',
  warn: 'This will bite you',
  wrong: 'What did not work',
  note: 'Note',
};
const heading = title ?? defaults[kind];
---

<aside class="callout" data-kind={kind}>
  <p class="ct">{heading}</p>
  <div class="cb"><slot /></div>
</aside>

<style>
  .callout {
    margin: 2em 0;
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 15px 20px;
    background: var(--bg-2);
  }
  .ct {
    margin: 0 0 8px;
    font: 600 10.5px/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tx-3);
  }
  .cb :global(> *:last-child) { margin-bottom: 0; }
  .cb { font-size: 16px; }

  [data-kind='key']   { border-left: 3px solid var(--ac);     }
  [data-kind='key']   .ct { color: var(--ac); }
  [data-kind='warn']  { border-left: 3px solid var(--warn);   }
  [data-kind='warn']  .ct { color: var(--warn); }
  [data-kind='wrong'] { border-left: 3px solid var(--bad);    }
  [data-kind='wrong'] .ct { color: var(--bad); }
  [data-kind='note']  { border-left: 3px solid var(--line);   }
</style>
