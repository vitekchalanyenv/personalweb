---
/**
 * Contours — animated SVG contour lines, generated at build time.
 *
 * This is the site's signature graphic device. Deterministic value noise turned
 * into smooth polylines, drawn as a survey map. It renders as inline SVG so it
 * is crisp at any size, costs no image request, and animates cheaply.
 *
 * The drift animation is a slow `transform: translate` on grouped lines at
 * different speeds — parallax without JavaScript and without repainting the
 * whole layer. Disabled under prefers-reduced-motion.
 */
interface Props {
  /** Changes the terrain. Same seed always produces the same lines. */
  seed?: number;
  /** Number of contour lines. */
  lines?: number;
  /** Viewbox aspect — wider for banners, squarer for cards. */
  w?: number;
  h?: number;
  /** 'accent' follows the global accent colour; 'neutral' is grey. */
  accent?: 'accent' | 'neutral';
  /** Animate a slow horizontal drift. */
  drift?: boolean;
  opacity?: number;
  class?: string;
}
const {
  seed = 7,
  lines = 22,
  w = 1200,
  h = 600,
  accent = 'accent',
  drift = false,
  opacity = 0.5,
  class: cls = '',
} = Astro.props;

/* --- deterministic PRNG so builds are reproducible --- */
function mulberry(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/* --- 1D value noise with smoothstep interpolation --- */
function makeNoise(rand: () => number, points: number) {
  const g = Array.from({ length: points + 1 }, () => rand());
  return (x: number) => {
    const p = x * points;
    const i = Math.floor(p);
    let f = p - i;
    f = f * f * (3 - 2 * f);
    const a = g[i % points];
    const b = g[(i + 1) % points];
    return a + (b - a) * f;
  };
}

const rand = mulberry(seed * 9973 + 17);

/* Build each contour as a fractal sum of a few octaves, offset vertically. A
   shared base field plus a per-line perturbation makes the lines feel like one
   landform rather than unrelated squiggles. */
const octaves = [
  { n: makeNoise(rand, 4), amp: 1.0 },
  { n: makeNoise(rand, 9), amp: 0.42 },
  { n: makeNoise(rand, 19), amp: 0.19 },
  { n: makeNoise(rand, 37), amp: 0.08 },
];
const jitter = makeNoise(rand, 6);

const STEPS = 88;
const paths: { d: string; index: boolean; band: number }[] = [];

for (let l = 0; l < lines; l++) {
  const t = l / (lines - 1);
  const baseY = h * (0.06 + t * 0.94);
  // higher lines compress slightly — reads as a slope receding
  const amplitude = h * (0.075 + 0.055 * Math.sin(t * Math.PI));
  const phase = t * 0.55;

  let d = '';
  for (let s = 0; s <= STEPS; s++) {
    const x = (s / STEPS) * w;
    const u = s / STEPS + phase;
    let v = 0;
    let total = 0;
    for (const o of octaves) {
      v += (o.n(u) - 0.5) * o.amp;
      total += o.amp;
    }
    v /= total;
    const y = baseY + v * amplitude * 2 + (jitter(t * 3 + s / STEPS) - 0.5) * h * 0.012;
    d += `${s === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`;
  }
  paths.push({ d, index: l % 5 === 0, band: l });
}

const groups = [0, 1, 2].map((k) => paths.filter((p) => p.band % 3 === k));
const uid = `ct${seed}${lines}`;
---

<svg
  class={`contours ${drift ? 'drift' : ''} ${cls}`}
  viewBox={`0 0 ${w} ${h}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  data-accent={accent}
  style={`--ct-op:${opacity}`}
>
  <defs>
    <linearGradient id={`${uid}-fade`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff" stop-opacity="0.15" />
      <stop offset="42%" stop-color="#fff" stop-opacity="1" />
      <stop offset="100%" stop-color="#fff" stop-opacity="0.22" />
    </linearGradient>
    <mask id={`${uid}-mask`}>
      <rect width={w} height={h} fill={`url(#${uid}-fade)`} />
    </mask>
  </defs>

  <g mask={`url(#${uid}-mask)`}>
    {
      groups.map((g, i) => (
        <g class={`layer l${i}`}>
          {g.map((p) => (
            <path d={p.d} class={p.index ? 'idx' : 'thin'} />
          ))}
        </g>
      ))
    }
  </g>
</svg>

<style>
  .contours {
    display: block;
    width: 100%;
    height: 100%;
    opacity: var(--ct-op, 0.5);
    overflow: visible;
  }
  path {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .thin {
    stroke-width: 1;
    stroke: var(--ct-line);
    opacity: 0.3;
  }
  .idx {
    stroke-width: 1.2;
    stroke: var(--ct-idx);
    opacity: 0.5;
  }

  /* Colour comes from the global accent so palette switches follow. */
  .contours { --ct-line: var(--ac); --ct-idx: var(--ac-soft); }
  [data-accent='neutral'] { --ct-line: var(--tx-3); --ct-idx: var(--tx-2); }

  /* Parallax drift: three layers, three speeds, no JS. */
  .drift .l0 { animation: ct-drift 64s linear infinite; }
  .drift .l1 { animation: ct-drift 88s linear infinite reverse; }
  .drift .l2 { animation: ct-drift 112s linear infinite; }

  @keyframes ct-drift {
    from { transform: translate3d(-2.5%, 0, 0); }
    50%  { transform: translate3d(2.5%, 0, 0); }
    to   { transform: translate3d(-2.5%, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .drift .layer { animation: none; }
  }
</style>
