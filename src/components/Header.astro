---
import { SITE_TITLE, LINKS } from '../consts';
const path = Astro.url.pathname;
const isCs = path.startsWith('/cs');
const base = isCs ? '/cs' : '';
const nav = isCs
  ? [['Články', `${base}/articles/`], ['Reference', `${base}/reference/`], ['Kity', `${base}/kits/`], ['Demo', `${base}/demo/`]]
  : [['Articles', '/articles/'], ['Reference', '/reference/'], ['Kits', '/kits/'], ['Demo', '/demo/']];
const on = (href: string) => path === href || (href !== `${base}/` && path.startsWith(href));
---
<header class="hd">
  <div class="wrap bar">
    <a class="brand" href={`${base}/`}>{SITE_TITLE}</a>

    <nav aria-label={isCs ? 'Hlavní navigace' : 'Main navigation'}>
      {nav.map(([label, href]) => (
        <a href={href} aria-current={on(href) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>

    <div class="tools">
      <a class="pf" href={LINKS.artstation}>Portfolio</a>
      <a class="ic lang" href={isCs ? path.replace(/^\/cs/, '') || '/' : `/cs${path}`}>{isCs ? 'EN' : 'CZ'}</a>
      <button class="ic" type="button" data-theme-toggle aria-label="Toggle theme">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .hd {
    position: sticky; top: 0; z-index: 40;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: 32px; min-height: 68px; flex-wrap: wrap; }
  .brand {
    font-weight: 560; font-size: 16px; color: var(--tx);
    letter-spacing: -0.02em; white-space: nowrap;
  }
  nav { display: flex; gap: 2px; margin-inline-start: auto; }
  nav a {
    color: var(--tx-2); font-size: 14.5px; font-weight: 450;
    padding: 8px 14px; border-radius: 100px; letter-spacing: -0.01em;
    transition: color .18s ease, background-color .18s ease;
  }
  nav a:hover { color: var(--tx); background: var(--bg-2); }
  nav a[aria-current='page'] { color: var(--tx); background: var(--bg-2); }
  .tools { display: flex; gap: 6px; align-items: center; }
  .pf {
    color: var(--tx-2); font-size: 14.5px; padding: 8px 14px;
    border-radius: 100px; border: 1px solid var(--line);
    transition: border-color .18s ease, color .18s ease;
  }
  .pf:hover { color: var(--tx); border-color: var(--line-2); }
  .ic {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 34px; height: 34px; padding: 0 9px;
    border: 1px solid var(--line); border-radius: 100px;
    background: transparent; color: var(--tx-3); cursor: pointer;
    font-family: var(--mono); font-size: 11px; letter-spacing: .06em;
    transition: color .18s ease, border-color .18s ease;
  }
  .ic:hover { color: var(--tx); border-color: var(--line-2); }
  @media (max-width: 820px) {
    .bar { gap: 14px; }
    nav { order: 3; width: 100%; margin-inline-start: 0; padding-bottom: 8px; overflow-x: auto; }
    .tools { margin-inline-start: auto; }
    .pf { display: none; }
  }
</style>

<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const r = document.documentElement;
    const light = r.getAttribute('data-theme') === 'light';
    light ? r.removeAttribute('data-theme') : r.setAttribute('data-theme', 'light');
    try { localStorage.setItem('theme', light ? 'dark' : 'light'); } catch (e) {}
  });
</script>
