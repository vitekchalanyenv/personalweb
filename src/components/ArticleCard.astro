---
import { SERIES } from '../content.config';
interface Props {
  slug: string; title: string; description: string;
  series: keyof typeof SERIES; episode: number; date: Date;
  cover?: string; coverAlt?: string;
}
const { slug, title, description, series, episode, date, cover, coverAlt } = Astro.props;
const s = SERIES[series];
const iso = date.toISOString().slice(0, 10);
---
<a class="ac lift" href={`/articles/${slug}/`}>
  {cover && (
    <span class="plate zoom">
      <img src={cover} alt={coverAlt ?? ''} loading="lazy" decoding="async" />
    </span>
  )}
  <span class="meta">
    <span class="ser">{s.title}</span>
    <span class="sep">/</span>
    <span class="ep">{String(episode).padStart(2, '0')}</span>
    <time datetime={iso}>{iso}</time>
  </span>
  <span class="t">{title}</span>
  <span class="d">{description}</span>
</a>

<style>
  .ac {
    display: flex; flex-direction: column;
    color: var(--tx); border-radius: var(--r);
    padding: 0; background: transparent; border: 0;
  }
  .plate { aspect-ratio: 16 / 10; margin-bottom: 20px; }
  .plate img { height: 100%; object-fit: cover; }
  .lift:hover { transform: translateY(-3px); background: transparent; }
  .meta {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    font-family: var(--mono); font-size: 11.5px; letter-spacing: .03em;
    color: var(--tx-3); margin-bottom: 12px;
  }
  .ser { color: var(--ac); }
  .sep { opacity: .4; }
  .ep { color: var(--tx-2); }
  .meta time { margin-inline-start: auto; font-variant-numeric: tabular-nums; }
  .t {
    font-size: 21px; font-weight: 540; letter-spacing: -0.022em;
    line-height: 1.3; margin-bottom: 10px; color: var(--tx);
    transition: color .18s ease;
  }
  .ac:hover .t { color: var(--ac); }
  .d { font-size: 15.5px; color: var(--tx-2); line-height: 1.65; }
</style>
