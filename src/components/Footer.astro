---
import { SITE_TITLE, LINKS, LOCATION } from '../consts';
const year = 2026;
const isCs = Astro.url.pathname.startsWith('/cs');
const out = Object.entries({
  ArtStation: LINKS.artstation,
  Fab: LINKS.fab,
  LinkedIn: LINKS.linkedin,
  YouTube: LINKS.youtube,
  Bluesky: LINKS.bluesky,
  Gumroad: LINKS.gumroad,
  'itch.io': LINKS.itch,
}).filter(([, href]) => href);
---
<footer class="site-foot">
  <div class="wrap">
    <div class="cols">
      <div>
        <p class="nm">{SITE_TITLE}</p>
        <p class="tiny">{LOCATION}</p>
        <p class="tiny"><a href={`mailto:${LINKS.email}`}>{LINKS.email}</a></p>
      </div>
      <div>
        <p class="h">{isCs ? 'Jinde' : 'Elsewhere'}</p>
        <ul>{out.map(([label, href]) => (<li><a href={href}>{label}</a></li>))}</ul>
      </div>
      <div>
        <p class="h">{isCs ? 'Tento web' : 'This site'}</p>
        <ul>
          <li><a href="/rss.xml">RSS</a></li>
          <li><a href="/sitemap-index.xml">Sitemap</a></li>
        </ul>
      </div>
    </div>
    <p class="fine">
      © {year} {SITE_TITLE}.
      {isCs
        ? ' Veškerá práce je vytvořená člověkem — žádná generativní AI, v žádné fázi, včetně referenčních boardů.'
        : ' All work is hand-authored — no generative AI at any stage, including reference boards.'}
    </p>
  </div>
</footer>

<style>
  .site-foot {
    border-top: 1px solid var(--line);
    margin-top: 80px;
    padding: 34px 0 44px;
    background: var(--bg-2);
  }
  .cols { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 28px; }
  @media (max-width: 700px) { .cols { grid-template-columns: 1fr 1fr; } }
  .nm { font-weight: 700; margin: 0 0 4px; }
  .h {
    font: 600 10.5px/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tx-3);
    margin: 0 0 10px;
  }
  ul { list-style: none; margin: 0; padding: 0; font-size: 14px; }
  li { margin-bottom: 5px; }
  .fine {
    margin: 28px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 12.5px;
    color: var(--tx-3);
  }
</style>
